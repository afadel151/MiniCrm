ingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="1620" height="22" as="geometry"/></mxCell>&#xa;<mxCell id="m1" value="&lt;b&gt;1.&lt;/b&gt; GET /app (no session)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="200" y="260" as="sourcePoint"/><mxPoint x="430" y="260" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m2" value="&lt;b&gt;2.&lt;/b&gt; 302 to identity /authorize (code, PKCE challenge, state)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="430" y="308" as="sourcePoint"/><mxPoint x="200" y="308" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m3" value="&lt;b&gt;3.&lt;/b&gt; login page (ar/fr): email + password (+ TOTP) or Sign in with Google" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="200" y="356" as="sourcePoint"/><mxPoint x="890" y="356" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m4" value="&lt;b&gt;4.&lt;/b&gt; 302 to BFF /auth/callback?code&amp;state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;font