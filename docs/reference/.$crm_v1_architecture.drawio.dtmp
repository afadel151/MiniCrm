one)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="430" y="862" as="sourcePoint"/><mxPoint x="660" y="862" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="note914" value="pending_confirmation to confirmed; consent stored; signals queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1"><mxGeometry x="540" y="892" width="240" height="40" as="geometry"/></mxCell>&#xa;<mxCell id="m11" value="&lt;b&gt;11.&lt;/b&gt; order.confirmed + shipment.requested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="660" y="976" as="sourcePoint"/><mxPoint x="1120" y="976" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m12" value="&lt;b&gt;12.&lt;/b&gt; shipment.requested (inbox)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1120" y="1028" as="sourcePoint"/><mxPoint x="1350" y="1028" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m13" value="&lt;b&gt;13.&lt;/b&gt; HTTPS create parcel (COD amount, wilaya); retry + circuit breaker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=bloc