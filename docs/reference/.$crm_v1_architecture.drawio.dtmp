<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="p1" name="1. System architecture (V1.0)"><mxGraphModel dx="2760" dy="1381" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3100" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cluster" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1A73E8;dashed=1;dashPattern=10 5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=11;fontColor=#1A73E8;" value="&lt;b&gt;Kubernetes cluster&lt;/b&gt; (namespace: prod) - GitOps-managed, NetworkPolicy per service, HPA/KEDA on queue depth" vertex="1"><mxGeometry height="1235" width="2300" x="300" y="255" as="geometry"/></mxCell><mxCell id="browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" value="&lt;b&gt;Browser / PWA&lt;/b&gt;&lt;br&gt;business owner &amp;amp; staff, client (B2C/B2B), web_master&lt;br&gt;Nuxt app: PrimeVue UI, Arabic (RTL) + French" vertex="1"><mxGeometry height="100" width="370" x="330" y="80" as="geometry"/></mxCell><mxCell id="custom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" value="&lt;b&gt;Custom store / integrator&lt;/b&gt;&lt;br&gt;calls the public REST API&lt;br&gt;(API key, Idempotency-Key)" vertex="1"><mxGeometry height="100" width="300" x="1720" y="80" as="geometry"/></mxCell><mxCell id="ingress" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=10;" value="&lt;b&gt;Ingress&lt;/b&gt; (NGINX / Traefik) - TLS 1.3, cert-manager, HSTS, WAF rules" vertex="1"><mxGeometry height="50" width="2240" x="330" y="300" as="geometry"/></mxCell><mxCell id="bff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=10;" value="&lt;b&gt;Nuxt BFF&lt;/b&gt; (Nuxt SSR + Nitro server)&lt;br&gt;SSR pages (ar RTL / fr), /api/** proxy, sealed HttpOnly session cookie,&lt;br&gt;tokens held server-side, CSRF: SameSite + Origin + custom header, realtime ticket mint" vertex="1"><mxGeometry height="130" width="520" x="330" y="400" as="geometry"/></mxCell><mxCell id="valkey" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=10;" value="&lt;b&gt;Valkey&lt;/b&gt; (Redis-compatible)&lt;br&gt;BFF sessions (sid to tokens), sid revocation set,&lt;br&gt;rate-limit counters, SignalR backplane" vertex="1"><mxGeometry height="110" width="350" x="950" y="410" as="geometry"/></mxCell><mxCell id="gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=10;strokeWidth=2;" value="&lt;b&gt;API Gateway&lt;/b&gt; (YARP) - JWT validation (cached JWKS), API-key auth for public API (lookup cached), rate limiting, sid-revocation check, route table, webhook ingress, OpenAPI edge" vertex="1"><mxGeometry height="90" width="2240" x="330" y="600" as="geometry"/></mxCell><mxCell id="svc_identity" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;identity-access (M0)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="330" y="800" as="geometry"/></mxCell><mxCell id="svc_identity_desc" parent="svc_identity" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Users, auth identities, sessions, MFA (TOTP), businesses, members, permissions, invitations, API keys.&lt;br&gt;ASP.NET Core Identity + OpenIddict: OIDC code+PKCE, JWT, JWKS, login pages (ar/fr), Google login." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_identity_api" parent="svc_identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_identity_box" parent="svc_identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_identity_db" parent="svc_identity" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" value="&lt;b&gt;identity_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" vertex="1"><mxGeometry height="76" width="140" x="35" y="246" as="geometry"/></mxCell><mxCell id="svc_crm" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;crm (M1)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="620" y="800" as="geometry"/></mxCell><mxCell id="svc_crm_desc" parent="svc_crm" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Contacts, phones (E.164 + phone_hash), tags, custom fields, pipelines, opportunities, interactions, call logs, tasks.&lt;br&gt;Local read models: members, tenants." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_crm_api" parent="svc_crm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_crm_box" parent="svc_crm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_crm_db" parent="svc_crm" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" value="&lt;b&gt;crm_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" vertex="1"><mxGeometry height="76" width="140" x="35" y="246" as="geometry"/></mxCell><mxCell id="svc_orders" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;orders (M2)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="910" y="800" as="geometry"/></mxCell><mxCell id="svc_orders_desc" parent="svc_orders" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Products, orders, confirmation links, order state machine, shipments, return cases (fault split).&lt;br&gt;gRPC client: scoring.GetScore. Read models: contacts, score tier." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_orders_api" parent="svc_orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_orders_box" parent="svc_orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_orders_db" parent="svc_orders" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" value="&lt;b&gt;orders_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" vertex="1"><mxGeometry height="76" width="140" x="35" y="246" as="geometry"/></mxCell><mxCell id="svc_scoring" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;scoring (M3)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="1200" y="800" as="geometry"/></mxCell><mxCell id="svc_scoring_desc" parent="svc_scoring" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Phone identities (hashed), signals, score models, snapshots, consents, disputes.&lt;br&gt;C# rules engine (ONNX later). Global layer behind a feature flag." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_scoring_api" parent="svc_scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_scoring_box" parent="svc_scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_scoring_db" parent="svc_scoring" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" value="&lt;b&gt;scoring_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" vertex="1"><mxGeometry height="76" width="140" x="35" y="246" as="geometry"/></mxCell><mxCell id="svc_messaging" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;messaging (M5)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="1490" y="800" as="geometry"/></mxCell><mxCell id="svc_messaging_desc" parent="svc_messaging" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Conversations, messages, templates (in-app + WhatsApp threads).&lt;br&gt;SignalR hub, Valkey backplane, one-time WSS ticket auth." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_messaging_api" parent="svc_messaging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_messaging_box" parent="svc_messaging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_messaging_db" parent="svc_messaging" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" value="&lt;b&gt;messaging_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" vertex="1"><mxGeometry height="76" width="140" x="35" y="246" as="geometry"/></mxCell><mxCell id="svc_presence" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;presence (M5)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="1780" y="800" as="geometry"/></mxCell><mxCell id="svc_presence_desc" parent="svc_presence" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Public business profiles, reviews, replies, reports.&lt;br&gt;Read-heavy public surface (cacheable); search later." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_presence_api" parent="svc_presence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_presence_box" parent="svc_presence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_presence_db" parent="svc_presence" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" value="&lt;b&gt;presence_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" vertex="1"><mxGeometry height="76" width="140" x="35" y="246" as="geometry"/></mxCell><mxCell id="svc_integrations" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;integrations (M4)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="2070" y="800" as="geometry"/></mxCell><mxCell id="svc_integrations_desc" parent="svc_integrations" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Connections, webhook inbox, external refs, imports. Adapters: Yalidine, ZR Express, Maystro, Ecotrack, Noest, WhatsApp, Shopify, SMS, email. Polly resilience." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_integrations_api" parent="svc_integrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_integrations_box" parent="svc_integrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_integrations_db" parent="svc_integrations" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" value="&lt;b&gt;integrations_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" vertex="1"><mxGeometry height="76" width="140" x="35" y="246" as="geometry"/></mxCell><mxCell id="svc_platform" parent="1" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" value="&lt;b&gt;platform (when needed)&lt;/b&gt;" vertex="1"><mxGeometry height="330" width="210" x="2360" y="800" as="geometry"/></mxCell><mxCell id="svc_platform_desc" parent="svc_platform" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" value="Notifications, file metadata, audit log, feature flags, reference data.&lt;br&gt;IFileStorage client (S3 API / local disk). Starts as shared library code." vertex="1"><mxGeometry height="100" width="194" x="8" y="52" as="geometry"/></mxCell><mxCell id="svc_platform_api" parent="svc_platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" vertex="1"><mxGeometry height="36" width="190" x="10" y="158" as="geometry"/></mxCell><mxCell id="svc_platform_box" parent="svc_platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" vertex="1"><mxGeometry height="36" width="190" x="10" y="200" as="geometry"/></mxCell><mxCell id="svc_platfor