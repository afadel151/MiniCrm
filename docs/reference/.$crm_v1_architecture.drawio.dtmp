ingle-flight lock)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#616161;fontColor=#616161;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="430" y="836" as="sourcePoint"/><mxPoint x="660" y="836" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m12" value="&lt;b&gt;12.&lt;/b&gt; (only when expiring) POST /connect/token grant=refresh_token, rotation + reuse detection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="430" y="892" as="sourcePoint"/><mxPoint x="890" y="892" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m13" value="&lt;b&gt;13.&lt;/b&gt; GET /v1/crm/contacts + Authorization: Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="430" y="948" as="sourcePoint"/><mxPoint x="1120" y="948" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m14" value="&lt;b&gt;14.&lt;/b&gt; sid revoked? + rate-limit counter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#616161;fontColor=#616161;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1120" y="996" as="sourcePoint"/><mxPoint x="660" y="996" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m15" value="&lt;b&gt;15.&lt;/b&gt; forward; JWT validated locally (cached JWKS, aud, exp)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1120" y="1044" as="sourcePoint"/><mxPoint x="1350" y="1044" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m16" value="&lt;b&gt;16.&lt;/b&gt; BEGIN; set_config('app.business_id', tid, true); SELECT ... (RLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1350" y="1092" as="sourcePoint"/><mxPoint x="1580" y="1092" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m17" value="&lt;b&gt;17.&lt;/b&gt; rows (tenant-filtered)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1580" y="1148" as="sourcePoint"/><mxPoint x="1350" y="1148" as="targetPoint"/><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>&#xa;<mxCell id="m18" value="&lt;b&gt;18.&lt;/b&gt; 200 JSON (back through gateway and BFF)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=