<mxCell id="svc_platform" value="&lt;b&gt;platform (when needed)&lt;/b&gt;" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2360" y="800" width="210" height="330" as="geometry"/></mxCell>
<mxCell id="svc_platform_desc" value="Notifications, file metadata, audit log, feature flags, reference data.&lt;br&gt;IFileStorage client (S3 API / local disk). Starts as shared library code." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" vertex="1" parent="svc_platform"><mxGeometry x="8" y="52" width="194" height="100" as="geometry"/></mxCell>
<mxCell id="svc_platform_api" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" vertex="1" parent="svc_platform"><mxGeometry x="10" y="158" width="190" height="36" as="geometry"/></mxCell>
