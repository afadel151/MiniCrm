<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="cluster" value="&lt;b&gt;Kubernetes cluster&lt;/b&gt; (namespace: prod) - GitOps-managed, NetworkPolicy per service, HPA/KEDA on queue depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1A73E8;dashed=1;dashPattern=10 5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=11;fontColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="300" y="255" width="2300" height="1235" as="geometry"/></mxCell>
<mxCell id="browser" value="&lt;b&gt;Browser / PWA&lt;/b&gt;&lt;br&gt;business owner &amp;amp; staff, client (B2C/B2B), web_master&lt;br&gt;Nuxt app: PrimeVue UI, Arabic (RTL) + French" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="370" height="100" as="geometry"/></mxCell>
<mxCell id="custom" value="&lt;b&gt;Custom store / integrator&lt;/b&gt;&lt;br&gt;calls the public REST API&lt;br&gt;(API key, Idempotency-Key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1720" y="80" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="ingress" value="&lt;b&gt;Ingress&lt;/b&gt; (NGINX / Traefik) - TLS 1.3, cert-manager, HSTS, WAF rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="2240" height="50" as="geometry"/></mxCell>
<mxCell id="bff" value="&lt;b&gt;Nuxt BFF&lt;/b&gt; (Nuxt SSR + Nitro server)&lt;br&gt;SSR pages (ar RTL / fr), /api/** proxy, sealed HttpOnly session cookie,&lt;br&gt;tokens held server-side, CSRF: SameSite + Origin + custom header, realtime ticket mint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="520" height="130" as="geometry"/></mxCell>
<mxCell id="valkey" value="&lt;b&gt;Valkey&lt;/b&gt; (Redis-compatible)&lt;br&gt;BFF sessions (sid to tokens), sid revocation set,&lt;br&gt;rate-limit counters, SignalR backplane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="410" width="350" height="110" as="geometry"/></mxCell>
<mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt; (YARP) - JWT validation (cached JWKS), API-key auth for public API (lookup cached), rate limiting, sid-revocation check, route table, webhook ingress, OpenAPI edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="2240" height="90" as="geometry"/></mxCell>
<mxCell id="svc_identity" value="&lt;b&gt;identity-access (M0)&lt;/b&gt;" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="210" height="330" as="geometry"/></mxCell>
<mxCell id="svc_identity_desc" value="Users, auth identities, sessions, MFA (TOTP), businesses, members, permissions, invitations, API keys.&lt;br&gt;ASP.NET Core Identity + OpenIddict: OIDC code+PKCE, JWT, JWKS, login pages (ar/fr), Google login." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" vertex="1" parent="svc_identity"><mxGeometry x="8" y="52" width="194" height="100" as="geometry"/></mxCell>
<mxCell id="svc_identity_api" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" vertex="1" parent="svc_identity"><mxGeometry x="10" y="158" width="190" height="36" as="geometry"/></mxCell>
<mxCell id="svc_identity_box" value="Outbox relay + inbox&lt;br&gt;(idempotent consumers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="svc_identity"><mxGeometry x="10" y="200" width="190" height="36" as="geometry"/></mxCell>
<mxCell id="svc_identity_db" value="&lt;b&gt;identity_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" vertex="1" parent="svc_identity"><mxGeometry x="35" y="246" width="140" height="76" as="geometry"/></mxCell>
<mxCell id="svc_crm" value="&lt;b&gt;crm (M1)&lt;/b&gt;" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="620" y="800" width="210" height="330" as="geometry"/></mxCell>
<mxCell id="svc_crm_desc" value="Contacts, phones (E.164 + phone_hash), tags, custom fields, pipelines, opportunities, interactions, call logs, tasks.&lt;br&gt;Local read models: members, tenants." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" vertex="1" parent="svc_crm"><mxGeometry x="8" y="52" width="194" height="100" as="geometry"/></mxCell>
<mxCell id="svc_crm_api" value="REST (OpenAPI) + gRPC server&lt;br&gt;JWT bearer, tenant from tid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=9;" vertex="1" parent="svc_crm"><mxGeometry x="10" y="158" width="190" height="36" as="geometry"/></mxCell>
