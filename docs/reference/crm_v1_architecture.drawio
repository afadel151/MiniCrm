<mxCell id="svc_scoring_desc" value="Phone identities (hashed), signals, score models, snapshots, consents, disputes.&lt;br&gt;C# rules engine (ONNX later). Global layer behind a feature flag." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" vertex="1" parent="svc_scoring"><mxGeometry x="8" y="52" width="194" height="100" as="geometry"/></mxCell>
