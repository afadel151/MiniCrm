<mxCell id="svc_messaging_desc" value="Conversations, messages, templates (in-app + WhatsApp threads).&lt;br&gt;SignalR hub, Valkey backplane, one-time WSS ticket auth." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" vertex="1" parent="svc_messaging"><mxGeometry x="8" y="52" width="194" height="100" as="geometry"/></mxCell>
