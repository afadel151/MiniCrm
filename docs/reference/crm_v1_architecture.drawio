<mxCell id="svc_platform_db" value="&lt;b&gt;platform_db&lt;/b&gt;&lt;br&gt;PostgreSQL + RLS (business_id)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;" vertex="1" parent="svc_platform"><mxGeometry x="35" y="246" width="140" height="76" as="geometry"/></mxCell>
<mxCell id="bus" value="&lt;b&gt;RabbitMQ&lt;/b&gt; (quorum queues, AMQP over TLS, publisher confirms) - topic exchange per producer: identity.events, crm.events, orders.events, scoring.events, integrations.events, messaging.events, presence.events, platform.events&lt;br&gt;one durable queue per consumer per source (e.g. orders.crm-events) - DLX + dead-letter queue per consumer - per-service credentials and vhost permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="1330" width="2240" height="110" as="geometry"/></mxCell>
<mxCell id="google" value="&lt;b&gt;Google&lt;/b&gt;&lt;br&gt;OAuth 2.0 / OIDC&lt;br&gt;(external login)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="third" value="&lt;b&gt;Third-party systems&lt;/b&gt;&lt;br&gt;- Carriers: Yalidine, ZR Express, Maystro, Ecotrack, Noest&lt;br&gt;- WhatsApp Cloud API&lt;br&gt;- Shopify Admin API&lt;br&gt;- SMS aggregator&lt;br&gt;- Email provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2700" y="820" width="300" height="190" as="geometry"/></mxCell>
<mxCell id="storage" value="&lt;b&gt;Object storage&lt;/b&gt; (S3-compatible protocol)&lt;br&gt;IFileStorage: tenant-prefixed keys,&lt;br&gt;scan then serve, presigned URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2700" y="1060" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="e_browser_ingress" value="HTTPS (TLS): pages, /api/**, WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;endSize=6;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A73E8;fontColor=#1A73E8;strokeWidth=2;exitX=0.4054;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0670;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="browser" target="ingress"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell>
