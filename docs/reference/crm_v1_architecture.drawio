<mxCell id="svc_orders" value="&lt;b&gt;orders (M2)&lt;/b&gt;" style="swimlane;startSize=44;whiteSpace=wrap;html=1;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="910" y="800" width="210" height="330" as="geometry"/></mxCell>
<mxCell id="svc_orders_desc" value="Products, orders, confirmation links, order state machine, shipments, return cases (fault split).&lt;br&gt;gRPC client: scoring.GetScore. Read models: contacts, score tier." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" vertex="1" parent="svc_orders"><mxGeometry x="8" y="52" width="194" height="100" as="geometry"/></mxCell>
