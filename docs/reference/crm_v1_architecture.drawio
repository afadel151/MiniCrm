<mxCell id="svc_presence_desc" value="Public business profiles, reviews, replies, reports.&lt;br&gt;Read-heavy public surface (cacheable); search later." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;spacing=2;" vertex="1" parent="svc_presence"><mxGeometry x="8" y="52" width="194" height="100" as="geometry"/></mxCell>
